{
  "permissions": {
    "auto_allow": [
      "read_file",
      "list_files",
      "grep_files",
      "ask_user",
      "read_artifact",
      "load_skill",
      "read_memory",
      "web_search",
      "web_fetch",
      "mcp__memory_rag__*",
      "mcp__code_index__search",
      "todo_write",
      "task"
    ],
    "require_confirm": [
      "run_command",
      "mcp__websearch__*"
    ],
    "require_diff_review": [
      "write_file",
      "edit_file"
    ],
    "always_deny": [],
    "path_allowlist": [
      "."
    ],
    "path_denylist": [
      ".env",
      "settings.json",
      "*.key",
      "*.pem",
      "secrets/"
    ]
  },
  "agent": {
    "max_iterations": 60,
    "compaction_threshold": 0.75,
    "stagnation_limit": 5,
    "history_keep_recent": 15,
    "fallback_providers": [
      "anthropic"
    ],
    "agent_mode": "react"
  },
  "token_budget": {
    "total": 128000,
    "system_prompt": 2000,
    "active_skills": 4000,
    "memory_index": 1000,
    "tool_schemas": 6000,
    "agent_state": 2000,
    "rag_chunks": 8000,
    "response_reserve": 8000
  },
  "llm": {
    "provider": "custom",
    "openai": {
      "api_key": "",
      "base_url": "",
      "model": "gpt-4o",
      "available_models": [
        "gpt-4o"
      ],
      "reasoning_effort": "high",
      "max_tokens": 8192,
      "wire_api": "chat"
    },
    "anthropic": {
      "api_key": "",
      "base_url": "",
      "model": "claude-sonnet-4-6",
      "available_models": [
        "claude-sonnet-4-6"
      ],
      "max_tokens": 8192,
      "thinking_budget": 0
    },
    "custom": {
      "api_key": "",
      "base_url": "https://api.deepseek.com/v1",
      "model": "deepseek-v4-flash",
      "available_models": [
        "deepseek-v4-flash",
        "deepseek-v4-pro",
        "deepseek-chat",
        "deepseek-reasoner"
      ],
      "reasoning_effort": "high",
      "max_tokens": 8192,
      "thinking_budget": 0,
      "wire_api": "chat"
    }
  }
}
