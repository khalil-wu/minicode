# MiniCode 环境配置
# 复制此文件为 .env 并填写实际值

# LLM Provider 选择: openai | anthropic | custom
LLM_PROVIDER=openai

# OpenAI 兼容中转配置
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
OPENAI_WIRE_API=responses

# 自定义 OpenAI/Anthropic 兼容 Provider（LLM_PROVIDER=custom 时使用）
CUSTOM_API_KEY=your-custom-provider-key-here
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_REASONING_EFFORT=
# chat | responses | anthropic
CUSTOM_WIRE_API=chat

# OpenMCP 外部 Provider（留空则自动回退到 .mcp.json 本地服务）
OPENMCP_SEARCH_URL=
OPENMCP_DOCPARSE_URL=

# Anthropic 配置（LLM_PROVIDER=anthropic 时使用）
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=
ANTHROPIC_MAX_TOKENS=8000
ANTHROPIC_THINKING_BUDGET=0

# Backend runtime
MINICODE_WS_MAX_SIZE_BYTES=1048576
