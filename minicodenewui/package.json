{
  "name": "minicode-newui-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MiniCode 新界面演示：全部逻辑在本地模拟，不连接后端，也不改动 MiniCode 本体。",
  "scripts": {
    "dev": "vite --port 5199 --open",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5199 --open",
    "typecheck": "tsc --noEmit",
    "smoke": "playwright test",
    "smoke:headed": "playwright test --headed"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource-variable/newsreader": "^5.2.5",
    "@shikijs/core": "3.20.0",
    "@shikijs/engine-javascript": "3.20.0",
    "@shikijs/langs": "3.20.0",
    "diff": "8.0.4",
    "lucide-react": "^0.460.0",
    "motion": "14.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
