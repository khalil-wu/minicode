{
  "mcpServers": {
    "websearch": {
      "command": "python",
      "args": [
        "-m",
        "backend.mcp.servers.websearch"
      ],
      "env": {},
      "autoStart": false,
      "transport": "stdio"
    },
    "docparse": {
      "command": "python",
      "args": [
        "-m",
        "backend.mcp.servers.docparse"
      ],
      "env": {},
      "autoStart": true,
      "transport": "stdio"
    },
    "memory-rag": {
      "command": "python",
      "args": [
        "-m",
        "backend.mcp.servers.memory_rag"
      ],
      "env": {},
      "autoStart": true,
      "transport": "stdio"
    },
    "code-index": {
      "command": "python",
      "args": [
        "-m",
        "backend.mcp.servers.code_index"
      ],
      "env": {},
      "autoStart": false,
      "transport": "stdio"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "env": {},
      "autoStart": true,
      "transport": "stdio"
    }
  }
}
