{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "prompt", "source", "baseline", "judges"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "prompt": {"type": "string", "minLength": 1},
    "source": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "required": ["git", "revision"],
          "properties": {
            "git": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
          },
          "additionalProperties": false
        }
      ]
    },
    "env": {"type": "object", "additionalProperties": {"type": "string"}},
    "setup": {"$ref": "#/$defs/commands"},
    "baseline": {"$ref": "#/$defs/commands"},
    "judges": {"$ref": "#/$defs/commands"},
    "agent_timeout_seconds": {"type": "number", "minimum": 1},
    "agent_verify_command": {"type": "string"},
    "agent_verify_timeout_seconds": {"type": "number", "minimum": 1},
    "agent_min_subagents": {"type": "integer", "minimum": 0},
    "agent_min_parallel_subagents": {"type": "integer", "minimum": 0},
    "agent_max_subagents": {"type": "integer", "minimum": 0},
    "baseline_patch": {"type": "string"},
    "seeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer"}
    },
    "minimum_pass_rate": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "tags": {"type": "array", "items": {"type": "string"}},
    "require_diff": {"type": "boolean"},
    "forbidden_changes": {"type": "array", "items": {"type": "string"}},
    "ignored_changes": {"type": "array", "items": {"type": "string"}},
    "file_judges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {"type": "string"},
          "must_exist": {"type": "boolean"},
          "contains": {"type": "array", "items": {"type": "string"}},
          "excludes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["argv"],
        "properties": {
          "name": {"type": "string"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "timeout_seconds": {"type": "number", "minimum": 1},
          "expected_exit_codes": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
          "env": {"type": "object", "additionalProperties": {"type": "string"}},
          "output_limit_chars": {"type": "integer", "minimum": 10000, "maximum": 10000000}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
